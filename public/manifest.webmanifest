{
  "name": "Pictogether",
  "short_name": "Pictogether",
  "description": "Su espacio para guardar recuerdos, ideas y momentos juntos.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fdf7f6",
  "theme_color": "#b03246",
  "icons": [
    { "src": "/icono-192-v2.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icono-512-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icono-maskable-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "fotos",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
